# API keys are OPTIONAL — the demo runs end-to-end on local hashed
# embeddings + canned answers when both are absent.

# Voyage AI — embeddings for retrieval (priority over OpenAI when set).
VOYAGE_API_KEY=

# Optional: override the default Voyage model (voyage-3.5-lite).
# Examples: voyage-3, voyage-3-large.
# VOYAGE_MODEL=voyage-3.5-lite

# Anthropic — Claude Sonnet 4.6 answer generation. When absent, the
# per-intent canned answer is served instead.
ANTHROPIC_API_KEY=

# Optional: OpenAI embeddings backend (used only if VOYAGE_API_KEY is unset).
# OPENAI_API_KEY=
